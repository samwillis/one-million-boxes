{
  "name": "1-million-boxes",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "author": "Databricks, Inc.",
  "description": "A multiplayer Dots & Boxes demo built with Postgres and Neon Realtime.",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:ui": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:realtime": "tsx scripts/test-realtime.ts",
    "db:reset": "tsx scripts/reset-game.ts",
    "simulate": "tsx scripts/simulate-game.ts",
    "setup:local-realtime": "tsx scripts/setup-local-realtime.ts",
    "format": "prettier . --write && tsx scripts/format-sql.ts --write",
    "format:check": "prettier . --check && tsx scripts/format-sql.ts --check",
    "db:init": "tsx scripts/init-db.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hono/node-server": "^2.1.3",
    "@neon/realtime": "0.0.1",
    "@vercel/functions": "^3.9.10",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@neon/config": "1.9.1",
    "@neon/env": "1.6.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "neon": "8.4.2",
    "pg-formatter": "2.0.8",
    "prettier": "3.9.9",
    "satori": "^0.34.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
