# Neon pooled Postgres connection string for API requests.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Direct connection for schema setup (pnpm db:init).
DATABASE_URL_UNPOOLED=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Realtime WebSocket endpoint and server-side capability secret for that project.
NEON_REALTIME_URL=wss://your-neon-realtime-endpoint
NEON_REALTIME_SECRET=your-neon-realtime-capability-secret

# Generate your own app secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TEAM_COOKIE_SECRET=replace-with-a-random-app-secret
API_PORT=3001
